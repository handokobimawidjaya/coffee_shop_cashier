<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_coffee_shop_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">coffee.shop.stock.report.wizard.form</field>
        <field name="model">coffee.shop.stock.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Laporan Stok">
                <group>
                    <field name="filter_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_coffee_shop_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Laporan Stok</field>
        <field name="res_model">coffee.shop.stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Wizard Menuitem -->
    <menuitem id="menu_coffee_shop_stock_report" 
              name="Laporan Stok" 
              parent="menu_coffee_shop_reporting" 
              action="action_coffee_shop_stock_report_wizard" 
              sequence="20"/>
</odoo>
