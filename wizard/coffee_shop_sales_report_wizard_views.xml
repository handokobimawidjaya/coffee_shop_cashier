<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_coffee_shop_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">coffee.shop.sales.report.wizard.form</field>
        <field name="model">coffee.shop.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Laporan Penjualan">
                <group>
                    <group string="Filter Tanggal">
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <group string="Filter Kategori">
                        <field name="product_categ_ids" widget="many2many_tags" placeholder="Semua Kategori..."/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_coffee_shop_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Laporan Penjualan</field>
        <field name="res_model">coffee.shop.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Wizard Menuitem -->
    <menuitem id="menu_coffee_shop_sales_report" 
              name="Laporan Penjualan" 
              parent="menu_coffee_shop_reporting" 
              action="action_coffee_shop_sales_report_wizard" 
              sequence="10"/>
</odoo>
