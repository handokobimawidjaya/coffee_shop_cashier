<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="coffee_shop_cashier.TicketScreenColumns"
       t-inherit="point_of_sale.TicketScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('header-row')]" position="replace">
            <div class="header-row d-flex text-bg-700 fw-bolder" t-att-class="{ 'd-none': ui.isSmall }">
                <div class="col p-2">Customer</div>
                <div class="col wide p-2">Order number</div>
                <div class="col end p-2">Total</div>
                <div class="col narrow p-2">Status</div>
                <div class="col very-narrow p-2" name="delete"></div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[1]" position="attributes">
            <attribute name="name">ticket-date</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[2]" position="attributes">
            <attribute name="name">ticket-receipt-number</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[3]" position="attributes">
            <attribute name="name">ticket-order-number</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[4]" position="attributes">
            <attribute name="name">ticket-customer</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[5]" position="attributes">
            <attribute name="name">ticket-cardholder</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[6]" position="attributes">
            <attribute name="name">ticket-cashier</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[7]" position="attributes">
            <attribute name="name">ticket-total</attribute>
        </xpath>
        <xpath expr="//div[hasclass('order-row') and not(contains(@class, 'mobileOrderList'))]/div[8]" position="attributes">
            <attribute name="name">ticket-status</attribute>
        </xpath>
        <xpath expr="//div[@name='ticket-customer']/div" position="replace">
            <div><t t-esc="order.customer_name"/></div>
        </xpath>

        <xpath expr="//div[hasclass('mobileOrderList')]/div[1]" position="replace">
            <div class="col p-2 d-flex justify-content-between align-items-center">
                <div><t t-esc="order.customer_name"/></div>
                <div><t t-esc="getTotal(order)"/></div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('mobileOrderList')]/div[2]" position="replace">
            <div class="col p-2 d-flex justify-content-between align-items-center">
                <div><t t-esc="order.tracking_number"/></div>
                <div class="orderStatus"><t t-esc="getStatus(order)"/></div>
            </div>
        </xpath>
    </t>
</templates>
