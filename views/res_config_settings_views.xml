<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit res.config.settings Form View -->
    <record id="res_config_settings_view_form_inherit_coffee" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.coffee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Coffee Shop Settings" id="coffee_shop_settings_section">
                    <setting id="coffee_shop_alert_email_setting" string="Stock Alerts Recipient" help="Email address that will receive alerts when stock levels drop below threshold.">
                        <field name="coffee_shop_alert_email" placeholder="e.g. manager@coffeeshop.com"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
